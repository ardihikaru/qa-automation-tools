# Goal Events API Endpoints

### GET /api/goal-events - List goal events
GET {{base_url}}/api/goal-events

> {%
  client.test("List goal events returns 200", function() {
    expect(response.status).to.equal(200);
  });
  
  client.test("Response is an array", function() {
    var body = JSON.parse(response.body);
    expect(body).to.be.an("array");
  });
%}

### GET /api/goal-events?goal_name=login - List goal events by name
GET {{base_url}}/api/goal-events?goal_name=login

> {%
  client.test("List goal events by name returns 200", function() {
    expect(response.status).to.equal(200);
  });
%}

### POST /api/goal-events - Create a new goal event
POST {{base_url}}/api/goal-events
Content-Type: application/json

{
  "goal_name": "patient_login",
  "confidence": 0.85,
  "page": "login",
  "action": "click_login"
}

> {%
  client.test("Create goal event returns 201", function() {
    expect(response.status).to.equal(201);
  });
  
  client.test("Response contains goal event data", function() {
    var body = JSON.parse(response.body);
    expect(body).to.have.property("id");
  });
%}

### DELETE /api/goal-events?id=1 - Delete a goal event
DELETE {{base_url}}/api/goal-events?id=1

> {%
  client.test("Delete goal event returns 200", function() {
    expect(response.status).to.equal(200);
  });
%}
# Flows API Endpoints

### GET /api/flows - List all flows
GET {{base_url}}/api/flows

> {%
  client.test("List flows returns 200", function() {
    expect(response.status).to.equal(200);
  });
  
  client.test("Response is an array", function() {
    var body = JSON.parse(response.body);
    expect(body).to.be.an("array");
  });
%}

### POST /api/flows - Create a new flow
POST {{base_url}}/api/flows
Content-Type: application/json

{
  "role_id": "1",
  "name": "Test Flow",
  "description": "A test flow for validation"
}

> {%
  client.test("Create flow returns 201", function() {
    expect(response.status).to.equal(201);
  });
  
  client.test("Response contains flow data", function() {
    var body = JSON.parse(response.body);
    expect(body).to.have.property("id");
    expect(body).to.have.property("name");
  });
%}

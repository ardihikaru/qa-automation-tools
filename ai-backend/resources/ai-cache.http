# AI Cache API Endpoints

### GET /api/ai-cache?hash=abc123 - Get cached AI response by hash
GET {{base_url}}/api/ai-cache?hash=abc123

> {%
  client.test("Get cached AI response returns 200", function() {
    expect(response.status).to.equal(200);
  });
  
  client.test("Response contains cached data", function() {
    var body = JSON.parse(response.body);
    expect(body).to.have.property("input_hash");
  });
%}

### POST /api/ai-cache - Store AI response in cache
POST {{base_url}}/api/ai-cache
Content-Type: application/json

{
  "input_text": "Summarize the patient registration flow",
  "output_text": "The patient registration flow involves several steps...",
  "model": "MiniMax-M2.5",
  "cost": 0.005
}

> {%
  client.test("Store AI cache returns 201", function() {
    expect(response.status).to.equal(201);
  });
  
  client.test("Response contains cache info", function() {
    var body = JSON.parse(response.body);
    expect(body).to.have.property("hash");
  });
%}

### DELETE /api/ai-cache?hash=abc123 - Delete specific cache entry
DELETE {{base_url}}/api/ai-cache?hash=abc123

> {%
  client.test("Delete cache entry returns 200", function() {
    expect(response.status).to.equal(200);
  });
%}

### DELETE /api/ai-cache - Clear all cache
DELETE {{base_url}}/api/ai-cache

> {%
  client.test("Clear all cache returns 200", function() {
    expect(response.status).to.equal(200);
  });
%}
# Learning Stats API Endpoints

### GET /api/learning/stats - Get learning statistics
GET {{base_url}}/api/learning/stats

> {%
  client.test("Get learning stats returns 200", function() {
    expect(response.status).to.equal(200);
  });
  
  client.test("Response contains stats data", function() {
    var body = JSON.parse(response.body);
    expect(body).to.have.property("total_records");
  });
%}
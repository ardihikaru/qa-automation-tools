# Learning Sequences API Endpoints

### GET /api/learning/sequences?goal=patient_registration - Get action sequences for a goal
GET {{base_url}}/api/learning/sequences?goal=patient_registration

> {%
  client.test("Get action sequences returns 200", function() {
    expect(response.status).to.equal(200);
  });
  
  client.test("Response is an array", function() {
    var body = JSON.parse(response.body);
    expect(body).to.be.an("array");
  });
%}

### POST /api/learning/sequences - Add a new action sequence
POST {{base_url}}/api/learning/sequences
Content-Type: application/json

{
  "goal": "patient_registration",
  "steps": "open_registration->fill_patient_info->upload_ktp->submit_form",
  "success": true,
  "duration_ms": 30000
}

> {%
  client.test("Add action sequence returns 201", function() {
    expect(response.status).to.equal(201);
  });
  
  client.test("Response confirms addition", function() {
    var body = JSON.parse(response.body);
    expect(body).to.have.property("added", true);
  });
%}
# Learning Context API Endpoints

### GET /api/learning/context?key=patient_type&value=VIP - Get context record
GET {{base_url}}/api/learning/context?key=patient_type&value=VIP

> {%
  client.test("Get context record returns 200", function() {
    expect(response.status).to.equal(200);
  });
%}

### POST /api/learning/context - Add a new context record
POST {{base_url}}/api/learning/context
Content-Type: application/json

{
  "context_key": "patient_type",
  "context_value": "VIP",
  "best_action": "open_vip_dashboard",
  "success": true
}

> {%
  client.test("Add context record returns 200", function() {
    expect(response.status).to.equal(200);
  });
  
  client.test("Response confirms addition", function() {
    var body = JSON.parse(response.body);
    expect(body).to.have.property("added", true);
  });
%}
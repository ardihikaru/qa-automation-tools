# Roles API Endpoints

### GET /api/roles - List all roles
GET {{base_url}}/api/roles

> {%
  client.test("List roles returns 200", function() {
    expect(response.status).to.equal(200);
  });
  
  client.test("Response is an array", function() {
    var body = JSON.parse(response.body);
    expect(body).to.be.an("array");
  });
%}

### POST /api/roles - Create a new role
POST {{base_url}}/api/roles
Content-Type: application/json

{
  "name": "doctor",
  "description": "Doctor role for medical system"
}

> {%
  client.test("Create role returns 201", function() {
    expect(response.status).to.equal(201);
  });
  
  client.test("Response contains role data", function() {
    var body = JSON.parse(response.body);
    expect(body).to.have.property("id");
    expect(body.name).to.equal("doctor");
  });
%}

### DELETE /api/roles?id=1 - Delete a role
DELETE {{base_url}}/api/roles?id=1

> {%
  client.test("Delete role returns 200", function() {
    expect(response.status).to.equal(200);
  });
%}
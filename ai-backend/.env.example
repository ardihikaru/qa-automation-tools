# ai-backend environment. Copy to .env (never commit real values).
# Canonical names are the ones read by internal/config/config.go and cmd/server/main.go.

# --- Server ---------------------------------------------------------------
PORT=8080

# --- Database: MySQL 8 (shared master-compose MySQL on db-host, over WireGuard) ---
# NOTE: the code reads DB_*. Legacy MYSQL_* names are ignored.
DB_HOST=10.8.0.4
DB_PORT=5306
DB_USER=qa_automation
DB_PASSWORD=
DB_NAME=qa_automation
# Optional full DSN instead of DB_* (a postgres:// value is ignored):
# DATABASE_URL=qa_automation:pass@tcp(10.8.0.4:5306)/qa_automation?parseTime=true

# --- AI gateway -----------------------------------------------------------
# ai-manager (default): production gateway, called directly over WireGuard.
AI_PROVIDER=ai-manager
AI_MANAGER_URL=http://10.8.0.4:8099
AI_MANAGER_LOGIN_ID=
AI_MANAGER_SECRET_KEY=
# Upstream inside ai-manager. This repo ALWAYS uses claude-v3 = the Claude CLI REST
# (ai-claude-cli) on app-host 10.8.0.9:8105, reached via ai-manager. Explicit-only in
# ai-manager; NO_FALLBACK=true makes any non-claude-v3 answer an error.
AI_MANAGER_PROVIDER=claude-v3
AI_MANAGER_NO_FALLBACK=true
AI_MANAGER_MODEL=
AI_TIMEOUT_SECONDS=180

# --- Playwright executor (systemd service on app-host) ----------------------
# Empty URL = /api/jobs/qa/run and /api/jobs/docs/generate stay simulated (dev default).
# Production: http://10.8.0.9:8141 + the same token as the executor's EXECUTOR_TOKEN.
PLAYWRIGHT_EXECUTOR_URL=
PLAYWRIGHT_EXECUTOR_TOKEN=
PLAYWRIGHT_EXECUTOR_TIMEOUT_MINUTES=30

# DORMANT — MiniMax direct. Not used: claude-v3 via ai-manager is the only supported
# LLM path. Kept only as an emergency manual switch (AI_PROVIDER=minimax) that needs
# the user's explicit approval.
MINIMAX_API_KEY=
AI_MODEL=MiniMax-M2.5
AI_BASE_URL=https://api.minimax.io/v1
AI_CHAT_ENDPOINT=/chat/completions

# --- Auth (cookie sessions; enabled only when the DB connects) -------------
SESSION_COOKIE_NAME=qa_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
DASHBOARD_ORIGIN=http://localhost:6173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# One-shot user seed from taskmgr Neo4j (optional; falls back to ADMIN_*)
TASKMGR_NEO4J_URI=
TASKMGR_NEO4J_USERNAME=
TASKMGR_NEO4J_PASSWORD=
TASKMGR_NEO4J_DATABASE=neo4j

# --- Security -------------------------------------------------------------
API_SECRET_KEY=change-this-in-production
# CORS_ORIGINS is loaded but unused; CORS follows DASHBOARD_ORIGIN.
CORS_ORIGINS=*

# --- Products: repo pool ---
# Directory where product repos are cloned/checked out (empty disables clone + verify).
REPO_POOL_DIR=
# GitHub token for `gh repo clone` / git fetch (secret; read access is enough).
GH_TOKEN=
# Scheduled re-verify interval in minutes (0 disables).
PRODUCTS_VERIFY_INTERVAL_MINUTES=360

# ai-backend environment. Copy to .env (never commit real values).
# Canonical names are the ones read by internal/config/config.go and cmd/server/main.go.

# --- Server ---------------------------------------------------------------
PORT=8080

# --- Database: MySQL 8 (shared master-compose MySQL on rnd-v2-vpn, over WireGuard) ---
# NOTE: the code reads DB_*. Legacy MYSQL_* names are ignored.
DB_HOST=10.10.0.4
DB_PORT=5306
DB_USER=qa_automation
DB_PASSWORD=
DB_NAME=qa_automation
# Optional full go-sql-driver/mysql DSN instead of DB_*:
# DATABASE_URL=qa_automation:pass@tcp(10.10.0.4:5306)/qa_automation?parseTime=true

# --- AI gateway -----------------------------------------------------------
# ai-manager (default): production gateway, called directly over WireGuard.
AI_PROVIDER=ai-manager
AI_MANAGER_URL=http://10.10.0.4:8099
AI_MANAGER_LOGIN_ID=
AI_MANAGER_SECRET_KEY=
# Upstream inside ai-manager. This repo ALWAYS uses claude-v3 = the Claude CLI REST
# (ai-claude-cli) on rnd-v3-vpn 10.10.0.9:8105, reached via ai-manager. Explicit-only in
# ai-manager; NO_FALLBACK=true makes any non-claude-v3 answer an error.
AI_MANAGER_PROVIDER=claude-v3
AI_MANAGER_NO_FALLBACK=true
AI_MANAGER_MODEL=
AI_TIMEOUT_SECONDS=180

# --- Playwright executor (systemd service on rnd-v3-vpn) ----------------------
# Empty URL = /api/jobs/qa/run and /api/jobs/docs/generate stay simulated (dev default).
# Production: http://10.10.0.9:8141 + the same token as the executor's EXECUTOR_TOKEN.
PLAYWRIGHT_EXECUTOR_URL=
PLAYWRIGHT_EXECUTOR_TOKEN=
PLAYWRIGHT_EXECUTOR_TIMEOUT_MINUTES=30

# --- GAOS integration (docs/designs/GAOS_INTEGRATION.md) -------------------
# Base URL of the GAOS REST API and the QA bearer token GAOS issued for this tool (scoped to
# specific GAOS products). Both must be set, or the "Integrated with GAOS" flag cannot be turned
# on and nothing is ever sent. URL: https, or http only to a loopback or 10.10.0.0/24 IP address;
# no userinfo, query or fragment. Token: starts with gaos_, at least 37 characters. Secret: set
# the value on the server only.
GAOS_API_URL=
GAOS_API_TOKEN=
# Public GAOS web app the /products badge links to. Optional: empty derives it from an https GAOS_API_URL.
GAOS_WEB_URL=
# Bearer token GAOS presents when it calls GET /api/v1/gaos/results and POST /api/v1/gaos/catalog
# on this server (docs/designs/GAOS_INBOUND.md). Unset = those routes answer 503 (fail-closed).
# Must start with gaos_, be at least 37 characters, and differ from GAOS_API_TOKEN. Secret.
GAOS_INBOUND_TOKEN=

# Bearer token the automation repo's CI presents to POST /api/v1/results/playwright?product=<id>
# (docs/designs/CASE_RESULTS.md). Unset = that route answers 503 (fail-closed). At least 32 characters,
# different from the GAOS tokens. Secret.
RESULTS_INGEST_TOKEN=

# DORMANT — MiniMax direct. Not used: claude-v3 via ai-manager is the only supported
# LLM path. Kept only as an emergency manual switch (AI_PROVIDER=minimax) that needs
# the user's explicit approval.
MINIMAX_API_KEY=
AI_MODEL=MiniMax-M2.5
AI_BASE_URL=https://api.minimax.io/v1
AI_CHAT_ENDPOINT=/chat/completions

# --- Auth (cookie sessions; enabled only when the DB connects) -------------
SESSION_COOKIE_NAME=qa_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
DASHBOARD_ORIGIN=http://localhost:6173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# AI service account (role "Service": may impersonate any user; Admin-equivalent).
# Seeded at startup when both are set. Password: >= 32 random chars, never
# overwritten once the user exists. See docs/designs/IMPERSONATION_AND_SERVICE_ACCOUNT.md
AI_SERVICE_USERNAME=
AI_SERVICE_PASSWORD=

# One-shot user seed from taskmgr Neo4j (optional; falls back to ADMIN_*)
TASKMGR_NEO4J_URI=
TASKMGR_NEO4J_USERNAME=
TASKMGR_NEO4J_PASSWORD=
TASKMGR_NEO4J_DATABASE=neo4j

# --- Security -------------------------------------------------------------
API_SECRET_KEY=change-this-in-production
# CORS_ORIGINS is loaded but unused; CORS follows DASHBOARD_ORIGIN.
CORS_ORIGINS=*

# --- Products: repo pool ---
# Directory where product repos are cloned/checked out (empty disables clone + verify).
REPO_POOL_DIR=
# GitHub token for `gh repo clone` / git fetch (secret; read access is enough).
GH_TOKEN=
# Scheduled re-verify interval in minutes (0 disables).
PRODUCTS_VERIFY_INTERVAL_MINUTES=360
# Scheduled product knowledge sync in minutes (0 disables); skipped when the commit is unchanged. PRODUCT_KNOWLEDGE_SYNC.md
KB_SYNC_INTERVAL_MINUTES=360
# Comma-separated GitHub owners that may be cloned (empty = any owner the token can read).
REPO_POOL_ALLOWED_OWNERS=

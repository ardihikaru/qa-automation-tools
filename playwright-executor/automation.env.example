# Template for ~/.config/qa-automation/automation-<productId>.env on the executor host (rnd-v3):
# the environment that case_run gives to the automation repo's Playwright process.
#
#   install -m 600 playwright-executor/automation.env.example ~/.config/qa-automation/automation-3.env
#   (then fill the values; the real file is git-ignored: `automation-*.env`)
#
# Rules: mode 600; STAGING ONLY. Every http(s) URL below must be on EXECUTOR_ALLOWED_HOSTS
# (playwright-executor.env), or the run is refused. Never commit real values. Values are never
# printed: the executor redacts them from events and logs.
# A double-quoted value may span lines or use \n (needed for a PEM key). Single quotes are literal.

# ── Targets (required) ───────────────────────────────────────────────────────
HIS_VENDOR_BACKEND_URL=https://stag-api-vendor-his-v3.sismedika.online/api/v1
HIS_BACKEND_GRAPHQL_URL=https://stag-api-graphql-hisv3.sismedika.online/api/v1
HIS_FRONTEND_URL=https://stag-app-hisv3.sismedika.online

# ── Safety net ────────────────────────────────────────────────────────────────
# Production hostnames, comma separated. The suite refuses to start if any *_URL host is listed
# (or has a prod/production label). Required (non-empty) on staging.
PROTECTED_HOSTS=online-his.sismedika.com,ext-url-his.sismedika.com

# ── Runner options ────────────────────────────────────────────────────────────
BROWSERS=chromium
ALLOW_DESTRUCTIVE=false
API_TIMEOUT_MS=30000

# ── his-frontend / his-backend login (optional: web specs and the GraphQL auth specs) ──────────
# A staging account (the shared session account is in practice a super admin on staging).
HIS_AUTH_USERNAME=
HIS_AUTH_PASSWORD=
# PEM public key of the staging backend (= VITE_APP_PUBLIC_KEY of his-frontend), on ONE line with \n:
# HIS_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
HIS_AUTH_PUBLIC_KEY=

# ── Kiosk (optional: kiosk-patient-whatsapp.spec.ts) ───────────────────────────────────────────
# Bearer token of a STAGING his-vendor-backend api_client allowed on /kiosk-his-v2/* (scopes
# kiosk:invoke, protected:read). Verify it first: without it a read endpoint answers 401, with it
# 400/200. Never use a production token.
HIS_VENDOR_KIOSK_TOKEN=
# A QA-owned number that IS registered on WhatsApp: digits only, country code first (62...).
# Without it the "registered phone" spec skips. Personal number: keep it out of git and reports.
E2E_WA_REGISTERED_PHONE=

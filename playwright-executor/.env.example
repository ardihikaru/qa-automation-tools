# playwright-executor environment (names and safe defaults only — never put real values here).
# Production copy: ~/.config/qa-automation/playwright-executor.env on app-host (mode 600).

# Listen address. Bind to the WireGuard IP only; never 0.0.0.0.
EXECUTOR_BIND=10.8.0.9
EXECUTOR_PORT=8141
# Shared bearer token (>= 32 chars). The same value goes into ai-backend PLAYWRIGHT_EXECUTOR_TOKEN.
EXECUTOR_TOKEN=

# Optional. STAGING only (never production): only seeds the default EXECUTOR_ALLOWED_HOSTS below.
TARGET_STAGING_URL=

# Hard per-run wall clock limit (seconds); the run's process group is killed when it expires.
RUN_TIMEOUT_SECONDS=900
# Runs waiting behind the active one. Concurrency is always 1.
MAX_QUEUE=10

# case_run (runs a test case of a product's automation repo; see README).
# Automation repo clones live here; repo_dir must resolve inside it.
EXECUTOR_REPO_POOL=/home/qa/devel/projects/qa-automation-tools/repos
# Holds automation-<productId>.env files (mode 600, never printed). Only automation-*.env names are selectable.
EXECUTOR_ENV_DIR=/home/qa/.config/qa-automation
# Hostnames the env files' base URLs may point at (comma-separated, "*.suffix" allowed). Default: the TARGET_STAGING_URL host.
EXECUTOR_ALLOWED_HOSTS=

# Navigation reporter (docs/designs/NAVIGATION_MAP.md): 0 turns it off; on by default when reporters/nav-reporter.cjs loads.
EXECUTOR_NAV_REPORTER=

# playwright-executor environment (names and safe defaults only — never put real values here).
# Production copy: ~/.config/qa-automation/playwright-executor.env on rnd-v3 (mode 600).

# Listen address. Bind to the WireGuard IP only; never 0.0.0.0.
EXECUTOR_BIND=10.10.0.9
EXECUTOR_PORT=8141
# Shared bearer token (>= 32 chars). The same value goes into ai-backend PLAYWRIGHT_EXECUTOR_TOKEN.
EXECUTOR_TOKEN=

# HISv3 STAGING only. Never point this at production HISv3.
HISV3_STAGING_URL=
# JSON file (mode 600): {"admin": {"username": "...", "password": "...", "role_code": "..."}, ...}
HISV3_CREDENTIALS_FILE=/home/sismedika/.config/qa-automation/hisv3-credentials.json
# Roles used when a run does not name any (must exist in the credentials file).
EXECUTOR_DEFAULT_ROLES=admin,doctor_gp,cashier

# Screenshots and run artifacts.
EXECUTOR_OUTPUT_DIR=/home/sismedika/qa-executor-data/runs
EXECUTOR_RETENTION_DAYS=7
# Hard per-run wall clock limit (seconds); the browser is killed when it expires.
RUN_TIMEOUT_SECONDS=900
# Runs waiting behind the active one. Concurrency is always 1 (one Chromium at a time).
MAX_QUEUE=10
EXECUTOR_HEADLESS=true

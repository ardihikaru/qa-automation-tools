# his-v3.qa.sismedika.com backend env. Copy to deploy/his-v3-qa/.env.prod on rnd-v3-vpn,
# chmod 600. NEVER commit .env.prod (gitignored via `.env*` rules below).

# --- MySQL: rnd-v2-vpn master-compose MySQL, over WireGuard ---
DB_HOST=10.10.0.4
DB_PORT=5306
DB_USER=qa_automation
DB_PASSWORD=
DB_NAME=qa_automation

# --- AI: production ai-manager on rnd-v2-vpn, over WireGuard ---
# Credentials = ~/.config/ai-stack/basic-auth.json (login_id / secret_key)
AI_PROVIDER=ai-manager
AI_MANAGER_URL=http://10.10.0.4:8099
AI_MANAGER_LOGIN_ID=
AI_MANAGER_SECRET_KEY=
# Upstream inside ai-manager. This repo ALWAYS uses claude-v3 = the Claude CLI REST
# (ai-claude-cli) on rnd-v3-vpn 10.10.0.9:8105, reached via ai-manager. Explicit-only in
# ai-manager; NO_FALLBACK=true makes any non-claude-v3 answer an error.
AI_MANAGER_PROVIDER=claude-v3
AI_MANAGER_NO_FALLBACK=true
AI_TIMEOUT_SECONDS=180

# --- Playwright executor: systemd user service on this host (deploy/playwright-executor) ---
# Reached from the backend container via the host WireGuard IP. Token = executor EXECUTOR_TOKEN.
PLAYWRIGHT_EXECUTOR_URL=http://10.10.0.9:8141
PLAYWRIGHT_EXECUTOR_TOKEN=
PLAYWRIGHT_EXECUTOR_TIMEOUT_MINUTES=30

# --- Products: repo pool (bind-mounted from <repo>/repos, see docker-compose.prod.yml) ---
# GH_TOKEN authenticates `gh repo clone` / git fetch for the product repos (read access is enough).
# Secret: set the value on the server only; never commit it.
GH_TOKEN=
# Re-verify every product on this interval (minutes). 0 disables the scheduled verify.
PRODUCTS_VERIFY_INTERVAL_MINUTES=360
# Comma-separated GitHub owners that may be cloned (empty = any owner the token can read).
REPO_POOL_ALLOWED_OWNERS=

# --- Auth / sessions (behind TLS edge) ---
DASHBOARD_ORIGIN=https://his-v3.qa.sismedika.com
# CORS_ORIGINS is loaded but unused; CORS follows DASHBOARD_ORIGIN.
CORS_ORIGINS=https://his-v3.qa.sismedika.com
SESSION_COOKIE_NAME=qa_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional one-shot user seed from taskmgr Neo4j (taskmgr-vpn 10.10.0.7)
TASKMGR_NEO4J_URI=
TASKMGR_NEO4J_USERNAME=
TASKMGR_NEO4J_PASSWORD=
TASKMGR_NEO4J_DATABASE=neo4j

# --- Compose port binding (WireGuard IP only) ---
HISV3QA_BIND_IP=10.10.0.9
HISV3QA_PORT=8140

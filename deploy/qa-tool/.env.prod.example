# qa.mfardiansyah.id backend env. Copy to deploy/qa-tool/.env.prod on app-host,
# chmod 600. NEVER commit .env.prod (gitignored via `.env*` rules below).

# --- MySQL: db-host master-compose MySQL, over WireGuard ---
DB_HOST=10.8.0.4
DB_PORT=5306
DB_USER=qa_automation
DB_PASSWORD=
DB_NAME=qa_automation

# --- AI: production ai-manager on db-host, over WireGuard ---
# Credentials = ~/.config/ai-stack/basic-auth.json (login_id / secret_key)
AI_PROVIDER=ai-manager
AI_MANAGER_URL=http://10.8.0.4:8099
AI_MANAGER_LOGIN_ID=
AI_MANAGER_SECRET_KEY=
AI_MANAGER_PROVIDER=
AI_TIMEOUT_SECONDS=180

# --- Auth / sessions (behind TLS edge) ---
DASHBOARD_ORIGIN=https://qa.mfardiansyah.id
CORS_ORIGINS=https://qa.mfardiansyah.id
SESSION_COOKIE_NAME=qa_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional one-shot user seed from taskmgr Neo4j (taskmgr-host 10.8.0.7)
TASKMGR_NEO4J_URI=
TASKMGR_NEO4J_USERNAME=
TASKMGR_NEO4J_PASSWORD=
TASKMGR_NEO4J_DATABASE=neo4j

# --- Compose port binding (WireGuard IP only) ---
QATOOL_BIND_IP=10.8.0.9
QATOOL_PORT=8140

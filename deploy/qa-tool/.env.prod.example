# qa-tool.mfardiansyah.id backend env. Copy to deploy/qa-tool/.env.prod on app-host,
# chmod 600. NEVER commit .env.prod (gitignored via `.env*` rules below).

# --- MySQL: db-host master-compose MySQL, over WireGuard ---
DB_HOST=10.8.0.4
DB_PORT=5306
DB_USER=qa_automation
DB_PASSWORD=
DB_NAME=qa_automation

# --- AI: production ai-manager on db-host, over WireGuard ---
# Credentials = ~/.config/ai-stack/basic-auth.json (login_id / secret_key)
AI_PROVIDER=ai-manager
AI_MANAGER_URL=http://10.8.0.4:8099
AI_MANAGER_LOGIN_ID=
AI_MANAGER_SECRET_KEY=
# Upstream inside ai-manager. This repo ALWAYS uses claude-v3 = the Claude CLI REST
# (ai-claude-cli) on app-host 10.8.0.9:8105, reached via ai-manager. Explicit-only in
# ai-manager; NO_FALLBACK=true makes any non-claude-v3 answer an error.
AI_MANAGER_PROVIDER=claude-v3
AI_MANAGER_NO_FALLBACK=true
# Knowledge translation EN->ID (docs/designs/KNOWLEDGE_TRANSLATION.md). Model sent per call through
# ai-manager (still pinned to claude-v3); explicitly empty disables translation. Products in parallel: 1 or 2.
AI_TRANSLATION_MODEL=claude-haiku-5-5
TRANSLATE_CONCURRENCY=1
AI_TIMEOUT_SECONDS=180

# --- Playwright executor: systemd user service on this host (deploy/playwright-executor) ---
# Reached from the backend container via the host WireGuard IP. Token = executor EXECUTOR_TOKEN.
PLAYWRIGHT_EXECUTOR_URL=http://10.8.0.9:8141
PLAYWRIGHT_EXECUTOR_TOKEN=
PLAYWRIGHT_EXECUTOR_TIMEOUT_MINUTES=30

# --- GAOS integration (docs/designs/GAOS_INTEGRATION.md) -------------------
# Base URL of the GAOS REST API and the QA bearer token GAOS issued for this tool (scoped to
# specific GAOS products). Both must be set, or the "Integrated with GAOS" flag cannot be turned
# on and nothing is ever sent. URL: https, or http only to a loopback or 10.8.0.0/24 IP address;
# no userinfo, query or fragment. Token: starts with gaos_, at least 37 characters. Secret: set
# the value on the server only.
# Production: https://gaos.mfardiansyah.id/api/v1
GAOS_API_URL=
GAOS_API_TOKEN=
# Public GAOS web app the /products badge links to. Optional: empty derives it from an https GAOS_API_URL.
GAOS_WEB_URL=
# Bearer token GAOS presents when it calls GET /api/v1/gaos/results and POST /api/v1/gaos/catalog
# on this server (docs/designs/GAOS_INBOUND.md). Unset = those routes answer 503 (fail-closed).
# Must start with gaos_, be at least 37 characters, and differ from GAOS_API_TOKEN. Secret.
GAOS_INBOUND_TOKEN=

# Bearer token the automation repo's CI presents to POST /api/v1/results/playwright?product=<id>
# (docs/designs/CASE_RESULTS.md). Unset = that route answers 503 (fail-closed). At least 32 characters,
# different from the GAOS tokens. Secret.
RESULTS_INGEST_TOKEN=

# --- Products: repo pool (bind-mounted from <repo>/repos, see docker-compose.prod.yml) ---
# GH_TOKEN authenticates `gh repo clone` / git fetch for the product repos (read access is enough).
# Secret: set the value on the server only; never commit it.
GH_TOKEN=
# Re-verify every product on this interval (minutes). 0 disables the scheduled verify.
PRODUCTS_VERIFY_INTERVAL_MINUTES=360
# Re-sync each product's knowledge base on this interval (minutes), only when the automation repo's
# commit or the parser changed. 0 disables the schedule (the Sync button still works).
KB_SYNC_INTERVAL_MINUTES=360
# Comma-separated GitHub owners that may be cloned (empty = any owner the token can read).
REPO_POOL_ALLOWED_OWNERS=
# Host path of the repo pool as playwright-executor sees it on app-host (the backend sees /data/repos).
# Needed for case run / create-automation (docs/designs/CASE_AUTOMATION.md).
# uid:gid handed to everything the pool creates, so playwright-executor (host user) can write node_modules/reports. Container runs as root.
REPO_POOL_OWNER=
REPO_POOL_HOST_DIR=/home/qa/devel/projects/qa-automation-tools/repos
# Executor env file prefix. Leave unset for the default instance (automation-<productId>.env). An extra
# instance sharing the executor sets it, e.g. personal -> automation-personal-<productId>.env.
# Must match ^[a-z][a-z0-9-]{0,20}$ (the backend refuses to start otherwise).
# EXECUTOR_ENV_PREFIX=personal

# --- Module checklist export cache (docs/designs/MODULE_CHECKLIST_EXPORT.md) ---
# S3-compatible object store (the staging MinIO that SUT uses). Leave all empty to disable the
# cache: the export endpoint then answers 503. Never commit values. Load them from the operator's
# own credentials file into this env only (secrets rule: do not print them).
# host:port, no scheme.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# The permanent bucket (not the temp bucket).
MINIO_BUCKET=
# Mandatory key segment, ^[a-z0-9][a-z0-9-]{0,31}$ (prod on app-host; something else in dev).
MINIO_KEY_NAMESPACE=
# false is accepted only for an endpoint IP inside 10.8.0.0/24 (WireGuard).
MINIO_USE_SSL=true
MINIO_TIMEOUT_SECONDS=30

# --- Auth / sessions (behind TLS edge) ---
DASHBOARD_ORIGIN=https://qa-tool.mfardiansyah.id
# CORS_ORIGINS is loaded but unused; CORS follows DASHBOARD_ORIGIN.
CORS_ORIGINS=https://qa-tool.mfardiansyah.id
SESSION_COOKIE_NAME=qa_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=12
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# AI service account (role "Service": may impersonate any user; Admin-equivalent).
# Seeded at startup when both are set. Password: >= 32 random chars, never
# overwritten once the user exists. See docs/designs/IMPERSONATION_AND_SERVICE_ACCOUNT.md
AI_SERVICE_USERNAME=ai-service
AI_SERVICE_PASSWORD=

# Optional one-shot user seed from taskmgr Neo4j (taskmgr-host 10.8.0.7)
TASKMGR_NEO4J_URI=
TASKMGR_NEO4J_USERNAME=
TASKMGR_NEO4J_PASSWORD=
TASKMGR_NEO4J_DATABASE=neo4j

# --- Compose port binding (WireGuard IP only) ---
QATOOL_BIND_IP=10.8.0.9
QATOOL_PORT=8140
# Second instance only (QATOOL_INSTANCE=<name>, file .env.<name>): its own port, e.g. 8150, and its own
# repo pool under the executor's pool root, e.g. ../../repos/<name> (REPO_POOL_HOST_DIR must match it).
# QATOOL_REPOS_DIR=../../repos

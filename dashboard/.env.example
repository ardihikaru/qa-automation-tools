# ============================================================
# QA Dashboard - Environment Configuration
# ============================================================
# This file contains configuration for the dashboard.
# Copy this to .env (gitignored) and update values as needed.
# DO NOT commit .env to version control!
# ============================================================

# API Backend URL (used in production via nginx)
VITE_API_URL=http://localhost:8080

# Development settings
VITE_DEV_SERVER_PORT=3000

# UI Settings
VITE_APP_TITLE=QA Automation Dashboard
VITE_APP_DEBUG=false
